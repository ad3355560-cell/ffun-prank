<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ghost Detector 👻</title>

<style>
body{
  margin:0;
  height:100vh;
  background:#050505;
  color:#00ff88;
  font-family:monospace;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
}
.box{width:90%;max-width:480px}
h1{font-size:30px}
#radar{
  width:220px;height:220px;
  border:3px solid #00ff88;
  border-radius:50%;
  margin:25px auto;
  position:relative;
  overflow:hidden;
}
#radar:after{
  content:"";
  position:absolute;
  width:50%;height:3px;
  background:#00ff88;
  top:50%;left:50%;
  transform-origin:left;
  animation:scan 1.2s linear infinite;
}
@keyframes scan{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}
button{
  padding:15px 30px;
  border:0;
  border-radius:10px;
  background:#00ff88;
  font-weight:bold;
  font-size:18px;
}
#result{display:none;color:white}
.warning{
  color:red;
  font-size:25px;
  animation:blink .5s infinite;
}
@keyframes blink{
  50%{opacity:.2}
}
</style>
</head>

<body>

<div class="box">

<h1>👻 GHOST DETECTOR</h1>

<p id="status">আপনার আশেপাশের পরিবেশ স্ক্যান করুন</p>

<button id="start" onclick="startScan()">START SCAN</button>

<div id="scanArea" style="display:none">
  <div id="radar"></div>
  <p id="progress">Scanning... 0%</p>
</div>

<div id="result">
  <p class="warning">⚠️ অস্বাভাবিক উপস্থিতি শনাক্ত!</p>
  <h2>👻 আপনার পিছনে কেউ আছে...</h2>
  <p>পেছনে তাকাবেন না... 😈</p>
</div>

<script>

function startScan(){

  document.getElementById("start").style.display="none";
  document.getElementById("status").innerText="পরিবেশ বিশ্লেষণ করা হচ্ছে...";
  document.getElementById("scanArea").style.display="block";

  // User interaction-এর পর vibration চেষ্টা
  if(navigator.vibrate){
    navigator.vibrate(150);
  }

  let p=0;

  let timer=setInterval(()=>{

    p++;
    document.getElementById("progress").innerText=
      "Scanning... "+p+"%";

    if(p>=100){

      clearInterval(timer);

      document.getElementById("scanArea").style.display="none";
      document.getElementById("status").style.display="none";
      document.getElementById("result").style.display="block";

      // Dramatic vibration pattern
      if(navigator.vibrate){
        navigator.vibrate([200,100,300,100,500]);
      }

      // Simple scary beep sound
      let ctx = new (window.AudioContext || window.webkitAudioContext)();
      let osc = ctx.createOscillator();
      let gain = ctx.createGain();

      osc.type="sawtooth";
      osc.frequency.value=90;
      gain.gain.value=0.15;

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start();

      setTimeout(()=>{
        osc.frequency.value=55;
      },500);

      setTimeout(()=>{
        osc.stop();
      },1200);

      // Reveal prank
      setTimeout(()=>{

        document.getElementById("result").innerHTML=`
          <h1>😂 PRANK!</h1>
          <p>কোনো ভূত নেই ভাই!</p>
          <p>তোমাকে শুধু একটু ভয় দেখালাম 👻🤣</p>
          <button onclick="location.reload()">আবার খেলো 😈</button>
        `;

      },4000);
    }

  },70);
}

</script>

</div>
</body>
</html>
